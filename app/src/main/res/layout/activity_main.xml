<?xml version="1.0" encoding="utf-8"?>
<layout>

    <data>

        <import type="android.view.View" />

        <variable
            name="viewModel"
            type="com.ewc.eudiwalletoidcandroid.MainViewModel" />
    </data>

    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnScan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/harness_scan" />

                <EditText
                    android:id="@+id/tvScanned"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:maxLines="3"
                    android:ellipsize="middle"
                    android:textIsSelectable="true"
                    android:textSize="12sp"
                    android:text="@={viewModel.scannedInput}"
                    android:inputType="textUri"
                    android:hint="@string/harness_paste_hint" />

                <Button
                    android:id="@+id/btnResolveOffer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/harness_step_offer" />

                <Button
                    android:id="@+id/btnIssuerMetadata"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/harness_step_issuer" />

                <Button
                    android:id="@+id/btnAuthServer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/harness_step_auth" />

                <Button
                    android:id="@+id/btnAuthorization"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/harness_step_authorization" />

                <EditText
                    android:id="@+id/etTxCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="12sp"
                    android:text="@={viewModel.txCode}"
                    android:inputType="number"
                    android:hint="@string/harness_tx_code_hint" />

                <Button
                    android:id="@+id/btnToken"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/harness_step_token" />

                <Button
                    android:id="@+id/btnRunAll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/harness_run_all" />

                <Button
                    android:id="@+id/btnClear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/harness_clear" />

                <TextView
                    android:id="@+id/tvOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="monospace"
                    android:textIsSelectable="true"
                    android:textSize="12sp"
                    android:text="@{viewModel.output}" />

            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/llProgressBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#88000000"
            android:gravity="center"
            android:visibility="@{viewModel.isLoading ? View.VISIBLE : View.GONE}">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </RelativeLayout>
</layout>
